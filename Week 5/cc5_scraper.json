{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 600,
  "height": 320,
  "title": {
    "text": "Brunson and Towns carry the Knicks' scoring",
    "subtitle": [
      "Points per game, 2026-27 regular season (early-season snapshot).",
      "Players with 5+ games played. Source: ESPN."
    ],
    "anchor": "start",
    "frame": "group",
    "subtitleColor": "#596870"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/kjones2026/kjones2026.github.io/refs/heads/main/Week%205/cc5_scraper_data.csv"
  },
  "transform": [
    {"pivot": "stat", "value": "value", "groupby": ["player", "position"]},
    {"filter": "datum.GP >= 5"}
  ],
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "player",
      "type": "nominal",
      "sort": "-x",
      "axis": {"title": "", "labelColor": "#596870", "ticks": false, "domain": false}
    },
    "x": {
      "field": "PTS",
      "type": "quantitative",
      "axis": {"title": "Points per game", "gridColor": "#e5e5e5", "domain": false}
    },
    "color": {
      "field": "position",
      "type": "nominal",
      "scale": {
        "domain": ["G", "F", "C"],
        "range": ["#6B84B2", "#E8857A", "#2A9D8F"]
      },
      "legend": {"title": "Position", "orient": "right"}
    },
    "tooltip": [
      {"field": "player", "type": "nominal", "title": "Player"},
      {"field": "position", "type": "nominal", "title": "Position"},
      {"field": "PTS", "type": "quantitative", "title": "Points per game"},
      {"field": "GP", "type": "quantitative", "title": "Games played"}
    ]
  },
  "config": {"view": {"strokeWidth": 0}}
}