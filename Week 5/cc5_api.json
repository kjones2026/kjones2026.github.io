{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 600,
  "height": 320,
  "title": {
    "text": "UK inflation, consumer prices (annual %)",
    "subtitle": "Live from the World Bank API",
    "anchor": "start",
    "frame": "group",
    "subtitleColor": "#596870"
  },
  "data": {
    "url": "https://api.worldbank.org/v2/country/GBR/indicator/FP.CPI.TOTL.ZG?format=json&per_page=200",
    "format": {"type": "json", "property": "1"}
  },
  "transform": [
    {"filter": "datum.value != null"},
    {"calculate": "toNumber(datum.date)", "as": "year"}
  ],
  "mark": {"type": "line", "point": true, "strokeWidth": 2.5, "color": "#6B84B2"},
  "encoding": {
    "x": {"field": "year", "type": "quantitative",
          "axis": {"title": "Year", "format": "d", "grid": false}},
    "y": {"field": "value", "type": "quantitative",
          "axis": {"title": "Inflation (%)"}},
    "tooltip": [
      {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
      {"field": "value", "type": "quantitative", "title": "Inflation (%)", "format": ".1f"}
    ]
  },
  "config": {"view": {"strokeWidth": 0}}
}