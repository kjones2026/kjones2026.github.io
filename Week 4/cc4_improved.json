{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 600,
  "height": 340,
  "padding": {"left": 5, "top": 5, "bottom": 5, "right": 130},
  "title": {
    "text": "Conflict deaths shifted from the Middle East to Europe after 2021",
    "subtitle": [
      "Best-estimate deaths in armed conflicts by region where they occurred, 2000 to 2026.",
      "Dashed segment: 2026 covers the first half of the year only."
    ],
    "fontSize": 16,
    "anchor": "start",
    "frame": "group",
    "subtitleColor": "#596870"
  },
  "data": {"url": "Week%204/cc4_conflict_deaths.csv"},
  "transform": [
    {"filter": {"field": "Entity", "oneOf": [
      "Asia and Oceania (UCDP)", "Middle East (UCDP)", "Europe (UCDP)", "Americas (UCDP)"
    ]}},
    {"calculate": "replace(datum.Entity, ' (UCDP)', '')", "as": "region"},
    {"filter": "datum.Year >= 2000"}
  ],
  "layer": [
    {
      "transform": [{"filter": "datum.Year <= 2025"}],
      "mark": {"type": "line", "strokeWidth": 2.5},
      "encoding": {
        "x": {
          "field": "Year", "type": "quantitative",
          "scale": {"domain": [2000, 2026]},
          "axis": {"title": "Year", "format": "d", "values": [2000, 2005, 2010, 2015, 2020, 2025],
                   "grid": false, "labelColor": "#596870"}
        },
        "y": {
          "field": "deaths", "type": "quantitative",
          "axis": {"title": "Deaths per year", "format": ",.0f", "gridColor": "#e5e5e5", "labelColor": "#596870"}
        },
        "color": {
          "field": "region", "type": "nominal", "legend": null,
          "scale": {"domain": ["Asia and Oceania", "Middle East", "Europe", "Americas"],
                    "range": ["#2A9D8F", "#C9A66B", "#6B84B2", "#E8857A"]}
        }
      }
    },
    {
      "transform": [{"filter": "datum.Year >= 2025"}],
      "mark": {"type": "line", "strokeWidth": 2.5, "strokeDash": [4, 4]},
      "encoding": {
        "x": {"field": "Year", "type": "quantitative", "scale": {"domain": [2000, 2026]}},
        "y": {"field": "deaths", "type": "quantitative"},
        "color": {
          "field": "region", "type": "nominal", "legend": null,
          "scale": {"domain": ["Asia and Oceania", "Middle East", "Europe", "Americas"],
                    "range": ["#2A9D8F", "#C9A66B", "#6B84B2", "#E8857A"]}
        }
      }
    },
    {
      "transform": [
        {"filter": "datum.Year == 2026"},
        {"calculate": "{'Europe':0,'Middle East':8,'Asia and Oceania':-8,'Americas':12}[datum.region]", "as": "dy"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 8, "fontWeight": "bold", "fontSize": 12},
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"},
        "y": {"field": "deaths", "type": "quantitative"},
        "text": {"field": "region", "type": "nominal"},
        "yOffset": {"field": "dy", "type": "quantitative", "scale": null},
        "color": {
          "field": "region", "type": "nominal", "legend": null,
          "scale": {"domain": ["Asia and Oceania", "Middle East", "Europe", "Americas"],
                    "range": ["#2A9D8F", "#C9A66B", "#6B84B2", "#E8857A"]}
        }
      }
    }
  ],
  "config": {"view": {"strokeWidth": 0}}
}