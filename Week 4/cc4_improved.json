{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 620,
  "height": 340,
  "title": {
    "text": "Since 2022, Europe has had more conflict deaths than any other region",
    "subtitle": [
      "Deaths in armed conflicts by region where they occurred (best estimates), 2005 to 2025.",
      "2026 is left out because only part of the year has been recorded."
    ],
    "fontSize": 16,
    "anchor": "start",
    "frame": "group",
    "subtitleColor": "#596870"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/kjones2026/kjones2026.github.io/refs/heads/main/Week%204/cc4_conflict_deaths.csv"
  },
  "transform": [
    {"filter": {"field": "Entity", "oneOf": ["Asia and Oceania (UCDP)", "Middle East (UCDP)", "Europe (UCDP)", "Americas (UCDP)"]}},
    {"calculate": "datum['Deaths in armed conflicts']", "as": "deaths"},
    {"calculate": "replace(datum.Entity, ' (UCDP)', '')", "as": "region"},
    {"filter": "datum.Year >= 2005 && datum.Year <= 2025"}
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "scale": {"domain": [2005, 2025]},
      "axis": {"title": null, "format": "d", "values": [2005, 2010, 2015, 2020, 2025], "grid": false, "labelColor": "#596870"}
    },
    "y": {
      "field": "deaths",
      "type": "quantitative",
      "axis": {"title": "Deaths per year", "format": ",.0f", "gridColor": "#e5e5e5", "labelColor": "#596870"}
    },
    "color": {
      "field": "region",
      "type": "nominal",
      "scale": {
        "domain": ["Europe", "Middle East", "Asia and Oceania", "Americas"],
        "range": ["#0072B2", "#D55E00", "#009E73", "#8C8C8C"]
      },
      "legend": {
        "title": null,
        "orient": "top",
        "direction": "horizontal",
        "symbolType": "stroke",
        "symbolStrokeWidth": 3,
        "symbolSize": 400,
        "labelFontSize": 12,
        "columnPadding": 18
      }
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "strokeWidth": 2.5}
    },
    {
      "mark": {"type": "point", "opacity": 0, "size": 160},
      "encoding": {
        "tooltip": [
          {"field": "region", "type": "nominal", "title": "Region"},
          {"field": "Year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "deaths", "type": "quantitative", "title": "Deaths", "format": ",.0f"}
        ]
      }
    }
  ],
  "config": {"view": {"strokeWidth": 0}}
}